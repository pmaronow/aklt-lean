  allowed a d := destinationCode a d != 0
  kind a d := match kindCode a d with | 0 => .straight | 1 => .turn | _ => .revisit
  successor a d := ⟨(destinationCode a d - 1) % 3741, Nat.mod_lt _ (by decide)⟩
  arrival a := direction (representativeCode a % 4)

end AKLT.Defs.Automaton10Data
