    `CertData.H3.Bridge.phaseNumerator.match_1,
    `CertData.H3.Bridge.replayedResult,
    `CertData.H3.Bridge.resultValue,
    `CertData.H3.Bridge.semanticBatch,
    `CertData.H3.Bridge.semanticStem,
    `CertData.H3.Bridge.stationaryV2_from_cases,
    `CertData.H3.Bridge.stationaryV2_of_cases]
  for modInfo in env.header.modules, data in env.header.moduleData do
    if (`RegenSamples).isPrefixOf modInfo.module then
      for n in data.constNames, info in data.constants do
        names := names.push n
        for c in info.getUsedConstantsAsSet do
          names := names.push c
  let mut seen : NameSet := {}
  for n in names do
    unless seen.contains n do
      seen := seen.insert n
      let record ← match env.find? n with
        | none => pure <| Json.mkObj [("name",toJson n.toString),("missing",toJson true)]
        | some info => do
          let typeFmt ← Lean.Meta.ppExpr info.type
          pure <| Json.mkObj [("name",toJson n.toString),
            ("name_structure",Lean.Idbg.nameToJson n),
            ("level_params",Json.arr (info.levelParams.toArray.map Lean.Idbg.nameToJson)),
            ("type_ast",Lean.Idbg.exprToJson info.type),
            ("type_pretty",toJson typeFmt.pretty),
            ("type_repr",toJson (reprStr info.type)),
            ("has_value",toJson info.hasValue)]
      Lean.logInfo m!"INTERFACE_JSON|{record.compress}"
