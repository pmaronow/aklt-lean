AKLT.Gen.Bellman.Automaton.arrivalCoeff_compatible.{u_1, u_2, u_3, u_4, u_5, u_6} {S : Type u_1} {Q : Type u_2}
  {D : Type u_3} {K : Type u_4} {C : Type u_5} {R : Type u_6} (A : AKLT.Gen.Bellman.Automaton S D K) (π : S → Q)
  (hsurj : Function.Surjective π) (usesArrival : K → Prop) (arrival : S → R) (base : C → D → K → ENNReal)
  (response : C → D → K → R → ENNReal)
  (harrival :
    ∀ (s t : S),
      π s = π t → ∀ (d : D) (k : K) (u : S), A.trans s d = some (k, u) → usesArrival k → arrival s = arrival t)
  (c : C) (s : S) (d : D) (k : K) (u : S) (he : A.trans s d = some (k, u)) :
  AKLT.Gen.Bellman.Automaton.arrivalCoeff usesArrival arrival base response c s d k =
    AKLT.Gen.Bellman.Automaton.quotientCoeff (AKLT.Gen.Bellman.Automaton.arrivalCoeff usesArrival arrival base response)
      π hsurj c (π s) d k
AKLT.Gen.Bellman.Automaton.quotient.{u_1, u_2, u_3, u_4} {S : Type u_1} {Q : Type u_2} {D : Type u_3} {K : Type u_4}
  (A : AKLT.Gen.Bellman.Automaton S D K) (π : S → Q) (hsurj : Function.Surjective π) : AKLT.Gen.Bellman.Automaton Q D K
AKLT.Gen.Bellman.Automaton.quotient_compatible.{u_1, u_2, u_3, u_4} {S : Type u_1} {Q : Type u_2} {D : Type u_3}
  {K : Type u_4} (A : AKLT.Gen.Bellman.Automaton S D K) (π : S → Q) (hsurj : Function.Surjective π)
  (hfibre :
    ∀ (s t : S),
      π s = π t →
        ∀ (d : D),
          AKLT.Gen.Bellman.Automaton.project π (A.trans s d) = AKLT.Gen.Bellman.Automaton.project π (A.trans t d)) :
  A.Compatible (A.quotient π hsurj) π
