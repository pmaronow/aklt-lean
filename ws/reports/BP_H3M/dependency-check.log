List.take_append_drop.{u_1} {α : Type u_1} (i : ℕ) (l : List α) : List.take i l ++ List.drop i l = l
List.toFinset.{u_1} {α : Type u_1} [DecidableEq α] (l : List α) : Finset α
tsum_eq_sum.{u_1, u_2} {α : Type u_1} {β : Type u_2} [AddCommMonoid α] [TopologicalSpace α] {f : β → α}
  {L : SummationFilter β} [L.LeAtTop] {s : Finset β} (hf : ∀ b ∉ s, f b = 0) : ∑'[L] (b : β), f b = ∑ b ∈ s, f b
