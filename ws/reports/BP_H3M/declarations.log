SuffixWindowValidityStatement : Prop
def AKLT.Blueprint.H3.SuffixWindowValidityStatement : Prop :=
∀ (n : ℕ) (w : Defs.DirectionWord n),
  Defs.IsTrail Defs.kernelStart Defs.kernelIncoming w →
    ∀ (i : Fin n), 10 ≤ ↑i → Defs.RawWindow (suffixWindow w ↑i) ∧ Defs.WindowAdmissible (suffixWindow w ↑i) (w i)
SuffixWindowLabelsStatement : Prop
def AKLT.Blueprint.H3.SuffixWindowLabelsStatement : Prop :=
∀ (n : ℕ) (w : Defs.DirectionWord n),
  Defs.IsTrail Defs.kernelStart Defs.kernelIncoming w →
    ∀ (i : Fin n),
      10 ≤ ↑i →
        Defs.windowSuccessor (suffixWindow w ↑i) (w i) = suffixWindow w (↑i + 1) ∧
          Defs.windowArrival (suffixWindow w ↑i) = Defs.wordIncoming Defs.kernelIncoming w i ∧
            (Defs.windowKind (suffixWindow w ↑i) (w i) = Defs.StepKind.revisit →
                Defs.wordRevisit Defs.kernelStart w i = true) ∧
              (Defs.wordRevisit Defs.kernelStart w i = false → Defs.windowKind (suffixWindow w ↑i) (w i) = trueKind w i)
IncidentBondBudgetStatement : Prop
def AKLT.Blueprint.H3.IncidentBondBudgetStatement : Prop :=
∀ (n : ℕ) (w : Defs.DirectionWord n),
  Defs.IsTrail Defs.kernelStart Defs.kernelIncoming w →
    ∀ (z : Defs.Plane), Defs.departureCount Defs.kernelStart w n z + arrivalCount w z ≤ 4
DepartureBalanceStatement : Prop
def AKLT.Blueprint.H3.DepartureBalanceStatement : Prop :=
∀ (n : ℕ) (w : Defs.DirectionWord n) (z : Defs.Plane), Defs.departureCount Defs.kernelStart w n z ≤ arrivalCount w z + 1
KnownSiteMemoryStatement : Prop
def AKLT.Blueprint.H3.KnownSiteMemoryStatement : Prop :=
∀ (X : Defs.PairType) (d₀ : Defs.Compass),
  d₀ ≠ Defs.Compass.east →
    ∀ (n L : ℕ),
      12 ≤ L →
        L ≤ n →
          ∀ (w : Defs.DirectionWord n),
            Defs.ClosedTrail X w →
              Defs.SurvivingPrefix X d₀ (Defs.takeWord w L) →
                (∀ (z : Defs.Plane), Defs.departureCount Defs.kernelStart w n z ≤ 2) →
                  ∀ (i : Fin n),
                    L ≤ ↑i →
                      Defs.wordVertex Defs.kernelStart w ↑i = Defs.kernelStart ∨
                          Defs.wordVertex Defs.kernelStart w ↑i = Defs.kernelStart + d₀.step →
                        Defs.wordRevisit Defs.kernelStart w i = true ∧
                          Defs.windowKind (suffixWindow w ↑i) (w i) ≠ Defs.StepKind.revisit ∧
                            {Defs.wordVertex Defs.kernelStart w ↑i,
                                Defs.wordVertex Defs.kernelStart w ↑i + (w i).step} ≠
                              {Defs.kernelStart, Defs.kernelStart + d₀.step}
TrueRewardIdentityStatement : Prop
def AKLT.Blueprint.H3.TrueRewardIdentityStatement : Prop :=
∀ (n : ℕ) (w : Defs.DirectionWord n),
  Defs.IsTrail Defs.kernelStart Defs.kernelIncoming w →
    ∀ (i : Fin n),
      w i ≠ (Defs.wordIncoming Defs.kernelIncoming w i).reverse ∧
        Defs.witnessKappa w i =
          Defs.relaxedReward (Defs.wordVertex Defs.kernelStart w ↑i) (Defs.wordIncoming Defs.kernelIncoming w i) (w i)
            (trueDeadSet w i)
RewardForgettingStatement : Prop
def AKLT.Blueprint.H3.RewardForgettingStatement : Prop :=
∀ (x : Defs.Plane) (incoming outgoing : Defs.Compass),
  outgoing ≠ incoming.reverse →
    ∀ (dead₁ dead₂ : Finset Defs.Plane),
      dead₁ ⊆ dead₂ → Defs.relaxedReward x incoming outgoing dead₂ ≤ Defs.relaxedReward x incoming outgoing dead₁
AKLT.Blueprint.H3.TrueStepFacts {n : ℕ} (X : Defs.PairType) (d₀ : Defs.Compass) (w : Defs.DirectionWord n) (i : Fin n) :
  Prop
LocalCoefficientComparisonStatement : Prop
def AKLT.Blueprint.H3.LocalCoefficientComparisonStatement : Prop :=
∀ (Q : Defs.MemoryQuotient 10 3741),
  Q.Correct →
    ∀ (X : Defs.PairType) (d₀ : Defs.Compass) (n : ℕ) (w : Defs.DirectionWord n) (i : Fin n),
      TrueStepFacts X d₀ w i →
        ∀ (φ ψ : Defs.Phase),
          Defs.truePhaseCoefficient w i φ ψ ≤
            Defs.stationaryCoefficient Q X d₀ φ (Q.project (suffixWindow w ↑i)) (Defs.wordVertex Defs.kernelStart w ↑i)
              (w i) ψ
ClosedTrailStepGeometryStatement : Prop
def AKLT.Blueprint.H3.ClosedTrailStepGeometryStatement : Prop :=
∀ (X : Defs.PairType) (n : ℕ) (w : Defs.DirectionWord n),
  Defs.ClosedTrail X w →
    ∀ (i : Fin n),
      Defs.wordVertex Defs.kernelStart w (↑i + 1) = Defs.wordVertex Defs.kernelStart w ↑i + (w i).step ∧
        Defs.wordVertex Defs.kernelStart w ↑i ≠ Defs.kernelCentre ∧
          Defs.wordVertex Defs.kernelStart w ↑i ≠ Defs.kernelTarget X ∧
            Defs.wordVertex Defs.kernelStart w (↑i + 1) ≠ Defs.kernelCentre
SuffixWordComparisonStatement : Prop
def AKLT.Blueprint.H3.SuffixWordComparisonStatement : Prop :=
∀ (Q : Defs.MemoryQuotient 10 3741),
  Q.Correct →
    ∀ (X : Defs.PairType) (d₀ : Defs.Compass) (L : ℕ),
      12 ≤ L →
        ∀ (P : Defs.DirectionWord L) (r : ℕ) (v : Defs.DirectionWord r),
          Defs.ClosedTrail X (Defs.appendWords P v) →
            (∀ (i : Fin (L + r)),
                L ≤ ↑i →
                  ∀ (φ ψ : Defs.Phase),
                    Defs.truePhaseCoefficient (Defs.appendWords P v) i φ ψ ≤
                      Defs.stationaryCoefficient Q X d₀ φ (Q.project (suffixWindow (Defs.appendWords P v) ↑i))
                        (Defs.wordVertex Defs.kernelStart (Defs.appendWords P v) ↑i) (Defs.appendWords P v i) ψ) →
              (∀ (i : Fin (L + r)),
                  L ≤ ↑i →
                    Q.successor (Q.project (suffixWindow (Defs.appendWords P v) ↑i)) (Defs.appendWords P v i) =
                      Q.project (suffixWindow (Defs.appendWords P v) (↑i + 1))) →
                ∀ (φ : Defs.Phase),
                  Defs.truePhaseSuffix (Defs.appendWords P v) L φ ≤
                    stationaryWordValue Q X d₀ (List.ofFn v) φ (Q.project (Defs.lastWindowWord 10 P))
                      (Defs.wordVertex Defs.kernelStart P L)
StationaryWordExpansionStatement : Prop
def AKLT.Blueprint.H3.StationaryWordExpansionStatement : Prop :=
∀ (Q : Defs.MemoryQuotient 10 3741) (X : Defs.PairType) (d₀ : Defs.Compass) (r : ℕ) (φ : Defs.Phase) (a : Fin 3741)
  (x : Defs.Plane),
  (Defs.stationaryApply Q X d₀)^[r] (Defs.stationaryReward X) φ a x =
    ∑ v, stationaryWordValue Q X d₀ (List.ofFn v) φ a x
FirstDirectionPartitionStatement : Prop
def AKLT.Blueprint.H3.FirstDirectionPartitionStatement : Prop :=
∀ (X : Defs.PairType) (R : ℕ),
  Defs.kernelPartialRow X R =
    Defs.firstDirectionPartialRow X Defs.Compass.north R + Defs.firstDirectionPartialRow X Defs.Compass.west R +
      Defs.firstDirectionPartialRow X Defs.Compass.south R
LengthShiftSupportStatement : Prop
def AKLT.Blueprint.H3.LengthShiftSupportStatement : Prop :=
∀ (X Y : Defs.PairType) (n s : ℕ), s ∉ lengthShifts X n → Defs.kernelLengthCoefficient X Y s n = 0
LengthRewardPartitionStatement : Prop
def AKLT.Blueprint.H3.LengthRewardPartitionStatement : Prop :=
∀ (X : Defs.PairType) (n : ℕ),
  kernelLengthRow X n = ∑ Y, ∑ s ∈ lengthShifts X n, Defs.kernelLengthCoefficient X Y s n * Defs.kernelWitness Y
KernelSeriesRegroupingStatement : Prop
def AKLT.Blueprint.H3.KernelSeriesRegroupingStatement : Prop :=
∀ (X : Defs.PairType),
  (∀ (Y : Defs.PairType) (n s : ℕ), s ∉ lengthShifts X n → Defs.kernelLengthCoefficient X Y s n = 0) →
    (∀ (n : ℕ),
        kernelLengthRow X n =
          ∑ Y, ∑ s ∈ lengthShifts X n, Defs.kernelLengthCoefficient X Y s n * Defs.kernelWitness Y) →
      ∑ Y, Defs.shiftedKernel 1 X Y * ENNReal.ofReal ↑(Defs.kernelWitness Y) =
        ∑' (n : ℕ), ENNReal.ofReal ↑(kernelLengthRow X n)
CutoffSeriesLiftStatement : Prop
def AKLT.Blueprint.H3.CutoffSeriesLiftStatement : Prop :=
∀ (f : ℕ → ℚ),
  (∀ (n : ℕ), 0 ≤ f n) →
    f 0 = 0 →
      ∀ (B : ℚ), (∀ (R : ℕ), ∑ n ∈ Finset.Icc 1 R, f n ≤ B) → ∑' (n : ℕ), ENNReal.ofReal ↑(f n) ≤ ENNReal.ofReal ↑B
