LongTrailPrefixStatement : Prop
def AKLT.Blueprint.H3.LongTrailPrefixStatement : Prop :=
∀ (X : Defs.PairType) (d₀ : Defs.Compass) (n : ℕ),
  12 < n →
    ∀ (w : Defs.DirectionWord n),
      Defs.ClosedTrail X w → Defs.FirstDirection w d₀ → Defs.SurvivingPrefix X d₀ (Defs.takeWord w 12)
WordSplitStatement : Prop
def AKLT.Blueprint.H3.WordSplitStatement : Prop :=
∀ (L r : ℕ),
  ∃ e,
    (∀ (w : Defs.DirectionWord (L + r)), (e w).1 = Defs.takeWord w L) ∧
      ∀ (P : Defs.DirectionWord L) (v : Defs.DirectionWord r), e.symm (P, v) = Defs.appendWords P v
LongRowRegroupingStatement : Prop
def AKLT.Blueprint.H3.LongRowRegroupingStatement : Prop :=
∀ (X : Defs.PairType) (d₀ : Defs.Compass) (R : ℕ),
  12 < R →
    (∀ (r : ℕ),
        ∃ e,
          (∀ (w : Defs.DirectionWord (12 + r)), (e w).1 = Defs.takeWord w 12) ∧
            ∀ (P : Defs.DirectionWord 12) (v : Defs.DirectionWord r), e.symm (P, v) = Defs.appendWords P v) →
      (∀ (n : ℕ),
          12 < n →
            ∀ (w : Defs.DirectionWord n),
              Defs.ClosedTrail X w → Defs.FirstDirection w d₀ → Defs.SurvivingPrefix X d₀ (Defs.takeWord w 12)) →
        (∀ (n : ℕ),
            12 < n →
              n ≤ R →
                ∀ (w : Defs.DirectionWord n),
                  Defs.ClosedTrail X w →
                    Defs.FirstDirection w d₀ →
                      Defs.closedContribution w =
                        ∑ φ, Defs.prefixPhases (Defs.takeWord w 12) φ * Defs.truePhaseSuffix w 12 φ) →
          Defs.firstDirectionPartialRow X d₀ R =
            Defs.firstDirectionPartialRow X d₀ 12 +
              ∑ P,
                if Defs.SurvivingPrefix X d₀ P then ∑ φ, Defs.prefixPhases P φ * Defs.trueContinuationSum X P φ (R - 12)
                else 0
