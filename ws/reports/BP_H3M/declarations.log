  (weight : Fin p → Fin p → Defs.StepKind → Defs.Compass → Defs.Compass → Defs.Plane → ℚ) (terminal : Defs.Plane → Bool)
  (F H : Fin p → Defs.DirectionWord m → Defs.Plane → ℚ) (φ : Fin p) (w : Defs.DirectionWord m) (x : Defs.Plane)
  (h :
    ∀ (ψ : Fin p) (d : Defs.Compass),
