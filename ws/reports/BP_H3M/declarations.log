'AKLT.Blueprint.H3.kernelLengthRow_zero' depends on axioms: [propext, Classical.choice, Quot.sound]
AKLT.Blueprint.H3.kernelPartialRow_eq_sum (X : Defs.PairType) (R : ℕ) :
  Defs.kernelPartialRow X R = ∑ n ∈ Finset.Icc 1 R, kernelLengthRow X n
'AKLT.Blueprint.H3.kernelPartialRow_eq_sum' depends on axioms: [propext, Classical.choice, Quot.sound]
PhaseFoldExpansionStatement : Prop
def AKLT.Blueprint.H3.PhaseFoldExpansionStatement : Prop :=
∀ (n : ℕ) (k : Fin n → Defs.StepKind) (r : Fin n → ℚ),
  ∑ φ,
      phaseRun (fun i => Defs.phaseTransition (k i) (r i)) (List.finRange n) Defs.phaseInitial φ *
        Defs.phaseTerminal φ =
    ∑ j, (singleChange k r j Defs.Phase.A Defs.Phase.C + singleChange k r j Defs.Phase.B Defs.Phase.D)
SingleChangeFactorStatement : Prop
def AKLT.Blueprint.H3.SingleChangeFactorStatement : Prop :=
∀ (n : ℕ) (w : Defs.DirectionWord n) (j : Fin n),
  singleChange (trueKind w) (Defs.witnessKappa w) j Defs.Phase.A Defs.Phase.C +
      singleChange (trueKind w) (Defs.witnessKappa w) j Defs.Phase.B Defs.Phase.D =
    Defs.trailBaseWeight Defs.kernelStart w * longRewardTerm w j
ExposureListExpansionStatement : Prop
def AKLT.Blueprint.H3.ExposureListExpansionStatement : Prop :=
∀ (n : ℕ) (w : Defs.DirectionWord n) (reward : Fin n → ℚ) (l : List (Fin n)),
  l.Nodup → Defs.exposureSum w reward l = ∑ j ∈ l.toFinset, reward j * orderedMultiplier w l j
LongOrderingMultiplierStatement : Prop
def AKLT.Blueprint.H3.LongOrderingMultiplierStatement : Prop :=
∀ (n : ℕ) (w : Defs.DirectionWord n),
  (Defs.longOrdering w).Nodup ∧
    (Defs.longOrdering w).toFinset = {j | Defs.wordRevisit Defs.kernelStart w j = false} ∧
      ∀ j ∈ Defs.longOrdering w, orderedMultiplier w (Defs.longOrdering w) j = longMultiplier w j
LongExposureExpansionStatement : Prop
def AKLT.Blueprint.H3.LongExposureExpansionStatement : Prop :=
∀ (n : ℕ) (w : Defs.DirectionWord n),
  Defs.exposureSum w (Defs.witnessKappa w) (Defs.longOrdering w) = ∑ j, longRewardTerm w j
PrefixCoefficientCausalityStatement : Prop
def AKLT.Blueprint.H3.PrefixCoefficientCausalityStatement : Prop :=
∀ (n : ℕ) (w : Defs.DirectionWord n) (L : ℕ) (hL : L ≤ n) (i : Fin L) (φ ψ : Defs.Phase),
  Defs.truePhaseCoefficient (Defs.takeWord w L) i φ ψ = Defs.truePhaseCoefficient w ⟨↑i, ⋯⟩ φ ψ
PhaseSplitAlgebraStatement : Prop
def AKLT.Blueprint.H3.PhaseSplitAlgebraStatement : Prop :=
∀ (n : ℕ) (w : Defs.DirectionWord n) (L : ℕ) (hL : L ≤ n),
  (∀ (i : Fin L) (φ ψ : Defs.Phase),
      Defs.truePhaseCoefficient (Defs.takeWord w L) i φ ψ = Defs.truePhaseCoefficient w ⟨↑i, ⋯⟩ φ ψ) →
    ∑ φ, Defs.prefixPhases w φ * Defs.phaseTerminal φ =
      ∑ φ, Defs.prefixPhases (Defs.takeWord w L) φ * Defs.truePhaseSuffix w L φ
