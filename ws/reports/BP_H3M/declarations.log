ReflectionGeometryStatement : Prop
def AKLT.Blueprint.H3.ReflectionGeometryStatement : Prop :=
∀ (n : ℕ) (w : Defs.DirectionWord n),
  (∀ (j : ℕ), Defs.wordVertex Defs.kernelStart (reflectWord w) j = reflectSite (Defs.wordVertex Defs.kernelStart w j)) ∧
    (Defs.ClosedTrail Defs.PairType.B w ↔ Defs.ClosedTrail Defs.PairType.B (reflectWord w)) ∧
      (Defs.FirstDirection w Defs.Compass.north ↔ Defs.FirstDirection (reflectWord w) Defs.Compass.south) ∧
        ∀ (i : Fin n),
          Defs.wordStraight Defs.kernelIncoming w i = Defs.wordStraight Defs.kernelIncoming (reflectWord w) i ∧
            Defs.wordRevisit Defs.kernelStart w i = Defs.wordRevisit Defs.kernelStart (reflectWord w) i
ReflectionLivePairsStatement : Prop
def AKLT.Blueprint.H3.ReflectionLivePairsStatement : Prop :=
∀ (n : ℕ) (w : Defs.DirectionWord n) (i : Fin n),
  Finset.image (fun p => Finset.image reflectSite p) (Defs.responsePairs w i) = Defs.responsePairs (reflectWord w) i
ReflectionPairLabelsStatement : Prop
def AKLT.Blueprint.H3.ReflectionPairLabelsStatement : Prop :=
∀ (n : ℕ) (w : Defs.DirectionWord n) (i : Fin n),
  ∀ p ∈ Defs.responsePairs w i,
    Defs.pairCoefficient w i p = Defs.pairCoefficient (reflectWord w) i (Finset.image reflectSite p) ∧
      Defs.responsePairType p = Defs.responsePairType (Finset.image reflectSite p) ∧
        Defs.pairShift Defs.PairType.B p = Defs.pairShift Defs.PairType.B (Finset.image reflectSite p)
ReflectionPairsStatement : Prop
def AKLT.Blueprint.H3.ReflectionPairsStatement : Prop :=
∀ (n : ℕ) (w : Defs.DirectionWord n) (i : Fin n),
  Finset.image (fun p => Finset.image reflectSite p) (Defs.responsePairs w i) = Defs.responsePairs (reflectWord w) i ∧
    ∀ p ∈ Defs.responsePairs w i,
      Defs.pairCoefficient w i p = Defs.pairCoefficient (reflectWord w) i (Finset.image reflectSite p) ∧
        Defs.responsePairType p = Defs.responsePairType (Finset.image reflectSite p) ∧
          Defs.pairShift Defs.PairType.B p = Defs.pairShift Defs.PairType.B (Finset.image reflectSite p)
ReflectionOrderingAlgebraStatement : Prop
def AKLT.Blueprint.H3.ReflectionOrderingAlgebraStatement : Prop :=
∀ (n : ℕ) (w : Defs.DirectionWord n),
  (∀ (i : Fin n),
      Defs.wordStraight Defs.kernelIncoming w i = Defs.wordStraight Defs.kernelIncoming (reflectWord w) i ∧
        Defs.wordRevisit Defs.kernelStart w i = Defs.wordRevisit Defs.kernelStart (reflectWord w) i ∧
          Defs.witnessKappa w i = Defs.witnessKappa (reflectWord w) i) →
    Defs.trailWeight Defs.kernelStart Defs.kernelIncoming w =
        Defs.trailWeight Defs.kernelStart Defs.kernelIncoming (reflectWord w) ∧
      Defs.kernelOrdering w = Defs.kernelOrdering (reflectWord w) ∧
        Defs.closedContribution w = Defs.closedContribution (reflectWord w)
