RawSuccessorStatement : Prop
def AKLT.Blueprint.H3.RawSuccessorStatement : Prop :=
∀ (m : ℕ),
  1 ≤ m →
    ∀ (w : Defs.DirectionWord m),
      Defs.RawWindow w → ∀ (d : Defs.Compass), Defs.WindowAdmissible w d → Defs.RawWindow (Defs.windowSuccessor w d)
ProjectionRealizationStatement : Prop
def AKLT.Blueprint.H3.ProjectionRealizationStatement : Prop :=
∀ (m q : ℕ),
  1 ≤ m →
    ∀ (π : Defs.DirectionWord m → Fin q),
      Defs.CompatibleProjection m q π →
        ∃ Q, Q.Correct ∧ ∀ (w : Defs.DirectionWord m), Defs.RawWindow w → Q.project w = π w
AKLT.Blueprint.H3.rawBackward_pullback {m q : ℕ} (Q : Defs.MemoryQuotient m q) (hQ : Q.Correct) (p : ℕ)
  (weight : Fin p → Fin p → Defs.StepKind → Defs.Compass → Defs.Compass → Defs.Plane → ℚ)
  (hweight :
    ∀ (φ ψ : Fin p) (d a a' : Defs.Compass) (x : Defs.Plane),
      weight φ ψ Defs.StepKind.revisit d a x = weight φ ψ Defs.StepKind.revisit d a' x)
  (terminal : Defs.Plane → Bool) (G : Fin p → Fin q → Defs.Plane → ℚ) (w : Defs.DirectionWord m) (hw : Defs.RawWindow w)
  (φ : Fin p) (x : Defs.Plane) :
  Defs.rawBackward m p weight terminal (fun ψ ω y => G ψ (Q.project ω) y) φ w x =
    Defs.quotientBackward Q p weight terminal G φ (Q.project w) x
'AKLT.Blueprint.H3.rawBackward_pullback' depends on axioms: [propext, Classical.choice, Quot.sound]
