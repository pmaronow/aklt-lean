AKLT.Gen.Bellman.Automaton.stopped_pullback.{u_1, u_2, u_3, u_4, u_5} {S : Type u_1} {Q : Type u_2} {D : Type u_3}
  {K : Type u_4} {C : Type u_5} (A : AKLT.Gen.Bellman.Automaton S D K) (B : AKLT.Gen.Bellman.Automaton Q D K)
  (π : S → Q) (hcompat : A.Compatible B π) (a : C → S → D → K → ENNReal) (b : C → Q → D → K → ENNReal)
  (hcoeff : ∀ (c : C) (s : S) (d : D) (k : K) (t : S), A.trans s d = some (k, t) → a c s d k = b c (π s) d k)
  (update : C → D → K → C) (stop : C × Q → Prop) (r : C × Q → ENNReal) (n : ℕ) (x : C × S) :
  A.stopped a update (fun y => stop (y.1, π y.2)) (fun y => r (y.1, π y.2)) n x =
    B.stopped b update stop r n (x.1, π x.2)
Finset.sum_congr.{u_1, u_4} {ι : Type u_1} {M : Type u_4} {s₁ s₂ : Finset ι} [AddCommMonoid M] {f g : ι → M}
  (h : s₁ = s₂) : (∀ x ∈ s₂, f x = g x) → s₁.sum f = s₂.sum g
Function.iterate_succ_apply'.{u} {α : Type u} (f : α → α) (n : ℕ) (x : α) : f^[n.succ] x = f (f^[n] x)
