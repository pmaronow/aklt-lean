AKLT.Blueprint.H3.rawBackward_pullback {m q : ℕ} (Q : AKLT.Defs.MemoryQuotient m q) (hQ : Q.Correct) (p : ℕ)
  (weight : Fin p → Fin p → AKLT.Defs.StepKind → AKLT.Defs.Compass → AKLT.Defs.Compass → AKLT.Defs.Plane → ℚ)
  (hweight :
    ∀ (φ ψ : Fin p) (d a a' : AKLT.Defs.Compass) (x : AKLT.Defs.Plane),
      weight φ ψ AKLT.Defs.StepKind.revisit d a x = weight φ ψ AKLT.Defs.StepKind.revisit d a' x)
  (terminal : AKLT.Defs.Plane → Bool) (G : Fin p → Fin q → AKLT.Defs.Plane → ℚ) (w : AKLT.Defs.DirectionWord m)
  (hw : AKLT.Defs.RawWindow w) (φ : Fin p) (x : AKLT.Defs.Plane) :
  AKLT.Defs.rawBackward m p weight terminal (fun ψ ω y => G ψ (Q.project ω) y) φ w x =
    AKLT.Defs.quotientBackward Q p weight terminal G φ (Q.project w) x
