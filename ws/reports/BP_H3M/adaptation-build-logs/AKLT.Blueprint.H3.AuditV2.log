StationaryCoefficientOffCentreStatementV2 : Prop
def AKLT.Blueprint.H3.StationaryCoefficientOffCentreStatementV2 : Prop :=
∀ (m q : ℕ) (Q : Defs.MemoryQuotient m q) (X : Defs.PairType) (d₀ : Defs.Compass) (φ : Defs.Phase) (a : Fin q)
  (x : Defs.Plane) (d : Defs.Compass) (ψ : Defs.Phase),
  x + d.step ≠ Defs.kernelCentre →
    Defs.stationaryCoefficientV2 Q X d₀ φ a x d ψ = Defs.stationaryCoefficient Q X d₀ φ a x d ψ
StationaryCentreZeroOperatorStatementV2 : Prop
def AKLT.Blueprint.H3.StationaryCentreZeroOperatorStatementV2 : Prop :=
∀ (m q : ℕ) (Q : Defs.MemoryQuotient m q) (X : Defs.PairType) (d₀ : Defs.Compass)
  (F : Defs.Phase → Fin q → Defs.Plane → ℚ),
  (∀ (φ : Defs.Phase) (a : Fin q), F φ a Defs.kernelCentre = 0) →
    ∀ (φ : Defs.Phase) (a : Fin q) (x : Defs.Plane),
      Defs.stationaryApplyV2 Q X d₀ F φ a x = Defs.stationaryApply Q X d₀ F φ a x
StationaryContinuationBridgeStatementV2 : Prop
def AKLT.Blueprint.H3.StationaryContinuationBridgeStatementV2 : Prop :=
∀ (Q : Defs.MemoryQuotient 10 3741) (X : Defs.PairType) (d₀ : Defs.Compass) (φ : Defs.Phase) (a : Fin 3741)
  (x : Defs.Plane) (R : ℕ),
  Defs.stationaryContinuationSumV2 Q X d₀ φ a x R = Defs.stationaryContinuationSum Q X d₀ φ a x R
StationaryCertificateBridgeStatementV2 : Prop
def AKLT.Blueprint.H3.StationaryCertificateBridgeStatementV2 : Prop :=
∀ (m q : ℕ) (Q : Defs.MemoryQuotient m q) (X : Defs.PairType) (d₀ : Defs.Compass) (C : Defs.StationaryData q),
  C.PassesV2 Q X d₀ → C.Passes Q X d₀
