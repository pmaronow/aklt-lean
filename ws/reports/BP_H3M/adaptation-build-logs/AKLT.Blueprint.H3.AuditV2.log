  (weight : Fin p → Fin p → Defs.StepKind → Defs.Compass → Defs.Compass → Defs.Plane → ℚ)
  (terminal : Fin p → Defs.DirectionWord m → Defs.Plane → Bool) (F : Fin p → Defs.DirectionWord m → Defs.Plane → ℚ)
  (φ : Fin p) (w : Defs.DirectionWord m) (x : Defs.Plane) : ℚ
AKLT.Blueprint.H3.quotientStoppedBackwardV2 {m q : ℕ} (Q : Defs.MemoryQuotient m q) (p : ℕ)
  (weight : Fin p → Fin p → Defs.StepKind → Defs.Compass → Defs.Compass → Defs.Plane → ℚ)
  (terminal : Fin p → Fin q → Defs.Plane → Bool) (F : Fin p → Fin q → Defs.Plane → ℚ) (φ : Fin p) (a : Fin q)
  (x : Defs.Plane) : ℚ
StoppedQuotientIntertwiningStatementV2 : Prop
def AKLT.Blueprint.H3.StoppedQuotientIntertwiningStatementV2 : Prop :=
∀ (m q : ℕ),
  1 ≤ m →
    ∀ (Q : Defs.MemoryQuotient m q),
      Q.Correct →
        (∀ (w : Defs.DirectionWord m),
            Defs.RawWindow w →
              ∀ (d : Defs.Compass), Defs.WindowAdmissible w d → Defs.RawWindow (Defs.windowSuccessor w d)) →
          ∀ (p : ℕ) (weight : Fin p → Fin p → Defs.StepKind → Defs.Compass → Defs.Compass → Defs.Plane → ℚ),
            (∀ (φ ψ : Fin p) (d a a' : Defs.Compass) (x : Defs.Plane),
                weight φ ψ Defs.StepKind.revisit d a x = weight φ ψ Defs.StepKind.revisit d a' x) →
              ∀ (terminalRaw : Fin p → Defs.DirectionWord m → Defs.Plane → Bool)
                (terminalQuotient : Fin p → Fin q → Defs.Plane → Bool),
                (∀ (φ : Fin p) (w : Defs.DirectionWord m),
                    Defs.RawWindow w → ∀ (x : Defs.Plane), terminalRaw φ w x = terminalQuotient φ (Q.project w) x) →
                  ∀ (rewardRaw : Fin p → Defs.DirectionWord m → Defs.Plane → ℚ)
                    (rewardQuotient : Fin p → Fin q → Defs.Plane → ℚ),
                    (∀ (φ : Fin p) (w : Defs.DirectionWord m),
                        Defs.RawWindow w → ∀ (x : Defs.Plane), rewardRaw φ w x = rewardQuotient φ (Q.project w) x) →
                      (∀ (φ : Fin p) (a : Fin q) (x : Defs.Plane),
                          terminalQuotient φ a x = false → rewardQuotient φ a x = 0) →
                        ∀ (R : ℕ) (φ : Fin p) (w : Defs.DirectionWord m),
                          Defs.RawWindow w →
                            ∀ (x : Defs.Plane),
                              ∑ j ∈ Finset.range (R + 1),
                                  (rawStoppedBackwardV2 m p weight terminalRaw)^[j] rewardRaw φ w x =
                                ∑ j ∈ Finset.range (R + 1),
                                  (quotientStoppedBackwardV2 Q p weight terminalQuotient)^[j] rewardQuotient φ
                                    (Q.project w) x
AutomatonQuotientPaperStatementV2 : Prop
def AKLT.Blueprint.H3.AutomatonQuotientPaperStatementV2 : Prop :=
Top.AutomatonQuotientStatement ∧
  ∀ (m q : ℕ),
    1 ≤ m →
      ∀ (Q : Defs.MemoryQuotient m q),
        Q.Correct →
          ∀ (p : ℕ) (weight : Fin p → Fin p → Defs.StepKind → Defs.Compass → Defs.Compass → Defs.Plane → ℚ),
            (∀ (φ ψ : Fin p) (d a a' : Defs.Compass) (x : Defs.Plane),
                weight φ ψ Defs.StepKind.revisit d a x = weight φ ψ Defs.StepKind.revisit d a' x) →
              ∀ (terminalRaw : Fin p → Defs.DirectionWord m → Defs.Plane → Bool)
                (terminalQuotient : Fin p → Fin q → Defs.Plane → Bool),
                (∀ (φ : Fin p) (w : Defs.DirectionWord m),
                    Defs.RawWindow w → ∀ (x : Defs.Plane), terminalRaw φ w x = terminalQuotient φ (Q.project w) x) →
                  ∀ (rewardRaw : Fin p → Defs.DirectionWord m → Defs.Plane → ℚ)
                    (rewardQuotient : Fin p → Fin q → Defs.Plane → ℚ),
                    (∀ (φ : Fin p) (w : Defs.DirectionWord m),
                        Defs.RawWindow w → ∀ (x : Defs.Plane), rewardRaw φ w x = rewardQuotient φ (Q.project w) x) →
                      (∀ (φ : Fin p) (a : Fin q) (x : Defs.Plane),
                          terminalQuotient φ a x = false → rewardQuotient φ a x = 0) →
                        ∀ (R : ℕ) (φ : Fin p) (w : Defs.DirectionWord m),
                          Defs.RawWindow w →
                            ∀ (x : Defs.Plane),
                              ∑ j ∈ Finset.range (R + 1),
                                  (rawStoppedBackwardV2 m p weight terminalRaw)^[j] rewardRaw φ w x =
                                ∑ j ∈ Finset.range (R + 1),
                                  (quotientStoppedBackwardV2 Q p weight terminalQuotient)^[j] rewardQuotient φ
                                    (Q.project w) x
AdaptationLeavesStatementV2 : Prop
def AKLT.Blueprint.H3.AdaptationLeavesStatementV2 : Prop :=
StationaryCoefficientOffCentreStatementV2 ∧
  StationaryCentreZeroOperatorStatementV2 ∧
    StationaryContinuationBridgeStatementV2 ∧
      StationaryCertificateBridgeStatementV2 ∧ StoppedQuotientIntertwiningStatementV2
LongTrailPhaseExpansionStatementV2 : Prop
def AKLT.Blueprint.H3.LongTrailPhaseExpansionStatementV2 : Prop :=
∀ (n : ℕ) (X : Defs.PairType) (w : Defs.DirectionWord n),
  Defs.ClosedTrail X w →
    12 < n →
      ∑ φ, Defs.prefixPhases w φ * Defs.phaseTerminal φ = Defs.closedContribution w ∧
        ∀ (L : ℕ) (hL : L ≤ n),
          have initialWord := fun i => w ⟨↑i, ⋯⟩;
          ∑ φ, Defs.prefixPhases w φ * Defs.phaseTerminal φ =
            ∑ φ, Defs.prefixPhases initialWord φ * Defs.truePhaseSuffix w L φ
