def AKLT.Blueprint.Win.TailThresholdStatement : Prop :=
∀ (θ : ℝ),
  0 < θ →
    θ < 1 →
      (∀ (u : ℕ), 1 ≤ u → tailCost θ u ≤ tailConstant θ * shellSpacing u ^ (-2)) →
        ∃ M, 1 ≤ M ∧ geometryThreshold 64 ≤ M ∧ ∀ (u : ℕ), M ≤ u → tailCost θ u ≤ 1
def AKLT.Blueprint.Win.FrameWeightPositiveStatement : Prop :=
AKLT.Blueprint.Top.ThreeFramesStatement →
  ∀ (κ : Plane → Fin 3),
    ProperPlaneColouring κ →
      ∀ (F : Finset Plane) (η : FrameBoundary F) (σ : PlaneConfiguration F), 0 < planeWeight κ F η σ
def AKLT.Blueprint.Win.tailCost : ℝ → ℕ → ℝ :=
fun θ u => 4 * (2 * ↑u + 1) ^ 2 * θ ^ (shellSpacing u / 12 - 1)
def AKLT.Blueprint.Win.tailConstant : ℝ → ℝ :=
fun θ => 36 * θ⁻¹ * ↑(Nat.factorial 10) * (12 / -Real.log θ) ^ 10
def AKLT.Defs.shellSpacing : ℕ → ℝ :=
fun u => √√↑u
def AKLT.Defs.planeWeight : (Plane → Fin 3) → (W : Finset Plane) → FrameBoundary W → PlaneConfiguration W → ℝ :=
fun κ W η σ =>
  ((1 / 12) ^ W.card *
      ∏ e ∈ internalBonds W,
        (1 + dot (frameVector (κ e.1) (extendLetters σ e.1)) (frameVector (κ e.2) (extendLetters σ e.2)))) *
    ∏ e ∈ originalLegs W,
      (1 + dot (frameVector (κ e.1) (extendLetters σ e.1)) (frameVector (κ e.2) (extendBoundary η e.2)))
def AKLT.Defs.ProperPlaneColouring : (Plane → Fin 3) → Prop :=
fun κ => ∀ (x y : Plane), Adjacent x y → κ x ≠ κ y
@[reducible] def AKLT.Defs.PlaneConfiguration : Finset Plane → Type :=
fun W => ↥W → IcoLetter
@[reducible] def AKLT.Defs.FrameBoundary : Finset Plane → Type :=
fun W => ↥(exteriorSites W) → IcoLetter
