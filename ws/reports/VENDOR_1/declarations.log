  {V : Type u_3} →
    [inst : Field K] →
      [inst_1 : AddCommGroup V] →
        [inst_2 : Module K V] →
          {h1 e1 f1 h2 e2 f2 : Module.End K V} →
            {n1 n2 : ℕ} →
              {g : Fin (n1 + 1) × Fin (n2 + 1) → V} →
                {motive : AKLT.Vendor.Physlib.Sl2.IsBivariateGrid h1 e1 f1 h2 e2 f2 n1 n2 g → Sort u_1} →
                  ((h1_apply : ∀ (a : Fin (n1 + 1)) (b : Fin (n2 + 1)), h1 (g (a, b)) = (↑n1 - 2 * ↑↑a) • g (a, b)) →
                      (h2_apply : ∀ (a : Fin (n1 + 1)) (b : Fin (n2 + 1)), h2 (g (a, b)) = (↑n2 - 2 * ↑↑b) • g (a, b)) →
                        (e1_zero : ∀ (b : Fin (n2 + 1)), e1 (g (0, b)) = 0) →
                          (e1_pos :
                              ∀ (a : Fin (n1 + 1)) (x : 0 < ↑a) (b : Fin (n2 + 1)),
                                e1 (g (a, b)) = (↑↑a * (↑n1 - ↑↑a + 1)) • g (⟨↑a - 1, ⋯⟩, b)) →
                            (f1_lt :
                                ∀ (a : Fin (n1 + 1)) (x : ↑a < n1) (b : Fin (n2 + 1)),
                                  f1 (g (a, b)) = g (⟨↑a + 1, ⋯⟩, b)) →
                              (f1_last : ∀ (b : Fin (n2 + 1)), f1 (g (Fin.last n1, b)) = 0) →
                                (e2_zero : ∀ (a : Fin (n1 + 1)), e2 (g (a, 0)) = 0) →
                                  (e2_pos :
                                      ∀ (a : Fin (n1 + 1)) (b : Fin (n2 + 1)) (x : 0 < ↑b),
                                        e2 (g (a, b)) = (↑↑b * (↑n2 - ↑↑b + 1)) • g (a, ⟨↑b - 1, ⋯⟩)) →
                                    (f2_lt :
                                        ∀ (a : Fin (n1 + 1)) (b : Fin (n2 + 1)) (x : ↑b < n2),
                                          f2 (g (a, b)) = g (a, ⟨↑b + 1, ⋯⟩)) →
                                      (f2_last : ∀ (a : Fin (n1 + 1)), f2 (g (a, Fin.last n2)) = 0) → motive ⋯) →
                    (t : AKLT.Vendor.Physlib.Sl2.IsBivariateGrid h1 e1 f1 h2 e2 f2 n1 n2 g) → motive t
