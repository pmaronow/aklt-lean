def AKLT.Defs.StoppedNetworkTrail : {G : Finset Plane} →
  {n : ℕ} → Network G → Plane → Finset Plane → DirectionWord n → Prop :=
fun {G} {n} D u T w =>
  Function.Injective (wordBond u w) ∧
    (∀ (i : Fin n), D.Present (wordVertex u w ↑i) (wordVertex u w (↑i + 1))) ∧
      (∀ j < n, wordVertex u w j ∉ T ∧ wordVertex u w j ∉ protectedSites G) ∧ wordVertex u w n ∈ T
def AKLT.Blueprint.Rec.CoveredDepartureV2 : {G : Finset Plane} → Network G → Plane → Compass → Compass → Prop :=
fun {G} D y incoming outgoing =>
  ∃ π,
    π.Covered ∧
      normalizeRotation incoming π.outgoing.step = outgoing.step ∧
        ∀ z ∈ templateSites \ templateTips,
          π.statusAt z = D.status (y + normalizeRotation incoming z) ∧
            (π.statusAt z ≠ Status.X →
              Finset.image (fun t => y + normalizeRotation incoming t) (π.keptAt z) ∩ G =
                D.kept (y + normalizeRotation incoming z))
def AKLT.Defs.PatternData.Covered : PatternData → Prop :=
fun π =>
  π.outgoing ≠ Compass.south ∧
    π.statusAt (0, 0) = Status.U ∧
      π.keptAt (0, 0) = {(1, 0), (0, 1), (-1, 0)} ∧
        (π.statusAt (0, -1) = Status.X ∨
            π.statusAt (0, -1) = Status.D ∧ (π.keptAt (0, -1)).card = 2 ∧ (0, 0) ∉ π.keptAt (0, -1)) ∧
          (∀ d ∈ {Compass.east, Compass.north, Compass.west},
              π.statusAt d.step = Status.U ∨
                π.statusAt d.step = Status.X ∨
                  π.statusAt d.step = Status.D ∧ (π.keptAt d.step).card = 2 ∧ (0, 0) ∈ π.keptAt d.step) ∧
            π.statusAt π.outgoing.step ≠ Status.X ∧
              (∀ x ∈ templateCorners,
                  π.statusAt x = Status.U ∨ π.statusAt x = Status.X ∨ π.statusAt x = Status.D ∧ (π.keptAt x).card = 2) ∧
                (∀ x ∈ templateSites,
                    x ≠ (0, 0) → x ∉ templateTips → π.statusAt x = Status.U → π.keptAt x = neighbours x) ∧
                  (∀ x ∈ templateTips, π.statusAt x = Status.U) ∧
                    ∀ x ∈ templateSites \ templateTips,
                      ∀ y ∈ templateSites \ templateTips,
                        π.statusAt x ≠ Status.X →
                          π.statusAt y ≠ Status.X → Adjacent x y → (y ∈ π.keptAt x ↔ x ∈ π.keptAt y)
def AKLT.Defs.Network.AdmissibleStart : {G : Finset Plane} → Network G → Plane → Prop :=
fun {G} D u =>
  u ∈ D.active ∧
    u ∉ protectedSites G ∧
      (D.status u = Status.U ∧ (D.presentNeighbours u).card ≤ 3 ∨
        D.status u = Status.D ∧ (D.presentNeighbours u).card ≤ 1)
def AKLT.Defs.AdmissibleTarget : {G : Finset Plane} → Network G → Plane → Prop :=
fun {G} D v =>
  v ∈ D.active ∧
    (D.status v = Status.U ∧ (D.presentNeighbours v).card + {e ∈ originalLegs G | e.1 = v}.card ≤ 3 ∨
      D.status v = Status.D ∧ (D.presentNeighbours v).card ≤ 1)
