def AKLT.Blueprint.Rec.NormalizeStartStatement : Prop :=
∀ (p : PairData),
  p.normalized.bonds = p.D.bonds ∧
    ∀ (b : Bool) (f : (Plane → Vec3) → ℝ), p.normalized.partition p.τ b f = p.D.partition p.τ b f
def AKLT.Blueprint.Rec.KeptInvariantStatement : Prop :=
∀ (p : PairSetup) (T : Finset Plane) (n : ℕ) (w : DirectionWord n),
  StoppedNetworkTrail p.normalized p.u T w →
    ∀ j ≤ n,
      have E := prefixNetwork p.normalized p.u w j;
      have y := wordVertex p.u w j;
      E.Auxiliary ∧
        (∀ x ∈ p.G, x ≠ y → E.status x = Status.U → E.kept x = neighbours x ∩ p.G) ∧
          (∀ x ∈ p.G, x ≠ y → E.status x = Status.D → (E.kept x).card = 2) ∧
            (∀ x ∈ E.active, ∀ z ∈ E.active, Adjacent x z → (z ∈ E.kept x ↔ x ∈ E.kept z)) ∧
              ∀ i < j, E.status (wordVertex p.u w i) ≠ Status.U
def AKLT.Blueprint.Rec.RemovedClosureStatement : Prop :=
∀ (p : PairSetup) (T : Finset Plane) (n : ℕ) (w : DirectionWord n),
  StoppedNetworkTrail p.normalized p.u T w →
    ∀ j ≤ n,
      wordVertex p.u w j ∉ protectedSites p.G →
        (removeSite (prefixNetwork p.normalized p.u w j) (wordVertex p.u w j)).Consistent
def AKLT.Blueprint.Rec.CoveredClosureStatement : Prop :=
∀ (p : PairSetup) (T : Finset Plane) (n : ℕ) (w : DirectionWord n),
  StoppedNetworkTrail p.normalized p.u T w →
    ∀ (i : Fin n),
      (prefixNetwork p.normalized p.u w ↑i).status (wordVertex p.u w ↑i) = Status.U →
        CoveredDepartureV2 (prefixNetwork p.normalized p.u w ↑i) (wordVertex p.u w ↑i) (wordIncoming p.incoming w i)
          (w i)
def AKLT.Blueprint.Rec.PairClosureStatement : Prop :=
∀ (p : PairSetup) (T : Finset Plane) (n : ℕ) (w : DirectionWord n),
  StoppedNetworkTrail p.normalized p.u T w →
    ∀ (i : Fin n),
      have E := prefixNetwork p.normalized p.u w ↑i;
      have y := wordVertex p.u w ↑i;
      E.status y = Status.U →
        ∀ a ∈ E.presentNeighbours y,
          ∀ b ∈ E.presentNeighbours y, a ≠ b → (removeSite E y).ResponsePair (responsePairType {a, b}) a b y
def AKLT.Blueprint.Rec.TerminalDefectStatement : Prop :=
∀ (p : PairSetup) (n : ℕ) (w : DirectionWord n),
  StoppedNetworkTrail p.normalized p.u (protectedSites p.G) w →
    have E := traceNetwork p.normalized (wordVertices p.u w);
    have e := wordVertex p.u w n;
    E.Auxiliary ∧ E.status e = Status.U ∧ ∀ x ∈ protectedSites p.G, x ≠ e → E.kept x = neighbours x ∩ p.G
def AKLT.Blueprint.Rec.SecondStartStatement : Prop :=
∀ (p : PairSetup),
  p.v ∉ protectedSites p.G →
    ∀ (n : ℕ) (w : DirectionWord n),
      StoppedNetworkTrail p.normalized p.u (insert p.v (protectedSites p.G)) w →
        wordVertex p.u w n ∈ protectedSites p.G →
          have E := normalizeStart (traceNetwork p.normalized (wordVertices p.u w)) p.v p.c;
          E.Auxiliary ∧ E.AdmissibleStart p.v ∧ ¬E.Present p.c p.v ∧ AdmissibleTarget E (wordVertex p.u w n)
def AKLT.Blueprint.Rec.TerminalExceptionLocationStatement : Prop :=
∀ (p : PairSetup),
  p.v ∉ protectedSites p.G →
    ∀ (n : ℕ) (w : DirectionWord n),
      StoppedNetworkTrail p.normalized p.u (insert p.v (protectedSites p.G)) w →
        wordVertex p.u w n ∈ protectedSites p.G →
          have E := normalizeStart (traceNetwork p.normalized (wordVertices p.u w)) p.v p.c;
          ∀ (incoming : Compass),
            p.v = p.c + incoming.step →
              ∀ (m : ℕ) (w' : DirectionWord m),
                StoppedNetworkTrail E p.v (protectedSites p.G) w' →
                  ∀ (i : Fin m),
                    (prefixNetwork E p.v w' ↑i).status (wordVertex p.v w' ↑i) = Status.U →
                      ¬CoveredDepartureV2 (prefixNetwork E p.v w' ↑i) (wordVertex p.v w' ↑i)
                            (wordIncoming incoming w' i) (w' i) →
                        0 < latticeDist (wordVertex p.v w' ↑i) (wordVertex p.u w n) ∧
                          latticeDist (wordVertex p.v w' ↑i) (wordVertex p.u w n) ≤ 2
