def AKLT.Blueprint.H1.PauliHermitianStatement : Prop :=
∀ (J : Finset.{0} (Fin 20)) (p : AKLT.Blueprint.H1.VectorPolynomial),
  Matrix.IsHermitian.{0, 0} (AKLT.Defs.pauliOperator J p)
def AKLT.Blueprint.H1.ReflectionParityStatement : Prop :=
∀ (J : Finset.{0} (Fin 20)) (p : AKLT.Blueprint.H1.VectorPolynomial),
  AKLT.Defs.VectorAffine p →
    AKLT.Defs.SupportedVectors J p →
      AKLT.Blueprint.H1.OrthogonalInvariant p →
        ∀ (a : ↥J → Fin 4),
          Odd.{0} (AKLT.Blueprint.H1.pauliYCount J a) →
            Eq.{1} ((AddMonoidAlgebra.coeff.{0, 0} p) (AKLT.Defs.pauliExponent J a)) 0
def AKLT.Blueprint.H1.PauliRealityStatement : Prop :=
∀ (J : Finset.{0} (Fin 20)) (p : AKLT.Blueprint.H1.VectorPolynomial),
  (∀ (a : ↥J → Fin 4),
      Odd.{0} (AKLT.Blueprint.H1.pauliYCount J a) →
        Eq.{1} ((AddMonoidAlgebra.coeff.{0, 0} p) (AKLT.Defs.pauliExponent J a)) 0) →
    ∀ (σ τ : ↥J → Fin 2), Eq.{1} (AKLT.Defs.pauliOperator J p σ τ).im 0
def AKLT.Blueprint.H1.InversionCovarianceStatement : Prop :=
∀ (p : AKLT.Blueprint.H1.VectorPolynomial),
  AKLT.Blueprint.H1.OrthogonalInvariant p →
    ∀ (I : Finset.{0} (Fin 20)), AKLT.Blueprint.H1.OrthogonalInvariant (AKLT.Defs.invertPolynomial I p)
def AKLT.Blueprint.H1.AdjointPauliCoordinatesStatement : Prop :=
∀ (g : Matrix.{0, 0, 0} (Fin 2) (Fin 2) ℂ),
  Eq.{1} (HMul.hMul.{0, 0, 0} (Matrix.conjTranspose.{0, 0, 0} g) g) 1 →
    Eq.{1} (Matrix.det.{0, 0} g) 1 →
      ∃ R,
        ∀ (j : Fin 3),
          Eq.{1}
            (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} g (AKLT.Defs.pauli ⟨HAdd.hAdd.{0, 0, 0} (↑j) 1, ⋯⟩))
              (Matrix.conjTranspose.{0, 0, 0} g))
            (∑ l, HSMul.hSMul.{0, 0, 0} (↑(R l j)) (AKLT.Defs.pauli ⟨HAdd.hAdd.{0, 0, 0} (↑l) 1, ⋯⟩))
def AKLT.Blueprint.H1.AdjointPauliOrthogonalStatement : Prop :=
∀ (g : Matrix.{0, 0, 0} (Fin 2) (Fin 2) ℂ),
  Eq.{1} (HMul.hMul.{0, 0, 0} (Matrix.conjTranspose.{0, 0, 0} g) g) 1 →
    ∀ (R : Matrix.{0, 0, 0} (Fin 3) (Fin 3) ℝ),
      (∀ (j : Fin 3),
          Eq.{1}
            (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} g (AKLT.Defs.pauli ⟨HAdd.hAdd.{0, 0, 0} (↑j) 1, ⋯⟩))
              (Matrix.conjTranspose.{0, 0, 0} g))
            (∑ l, HSMul.hSMul.{0, 0, 0} (↑(R l j)) (AKLT.Defs.pauli ⟨HAdd.hAdd.{0, 0, 0} (↑l) 1, ⋯⟩))) →
        Eq.{1} (HMul.hMul.{0, 0, 0} (Matrix.transpose.{0, 0, 0} R) R) 1
def AKLT.Blueprint.H1.PauliRotationTransferStatement : Prop :=
∀ (J : Finset.{0} (Fin 20)) (p : AKLT.Blueprint.H1.VectorPolynomial),
  AKLT.Defs.VectorAffine p →
    AKLT.Defs.SupportedVectors J p →
      AKLT.Blueprint.H1.OrthogonalInvariant p →
        ∀ (g : Matrix.{0, 0, 0} (Fin 2) (Fin 2) ℂ),
          Eq.{1} (HMul.hMul.{0, 0, 0} (Matrix.conjTranspose.{0, 0, 0} g) g) 1 →
            ∀ (R : Matrix.{0, 0, 0} (Fin 3) (Fin 3) ℝ),
              Eq.{1} (HMul.hMul.{0, 0, 0} (Matrix.transpose.{0, 0, 0} R) R) 1 →
                (∀ (j : Fin 3),
                    Eq.{1}
                      (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} g (AKLT.Defs.pauli ⟨HAdd.hAdd.{0, 0, 0} (↑j) 1, ⋯⟩))
                        (Matrix.conjTranspose.{0, 0, 0} g))
                      (∑ l, HSMul.hSMul.{0, 0, 0} (↑(R l j)) (AKLT.Defs.pauli ⟨HAdd.hAdd.{0, 0, 0} (↑l) 1, ⋯⟩))) →
                  Commute.{0} (AKLT.Defs.pauliOperator J p) (AKLT.Defs.tensorPowerMatrix J g)
def AKLT.Blueprint.H1.CayleyTensorCommutationStatement : Prop :=
∀ (J : Finset.{0} (Fin 20)) (M : Matrix.{0, 0, 0} (↥J → Fin 2) (↥J → Fin 2) ℂ),
  (∀ (g : Matrix.{0, 0, 0} (Fin 2) (Fin 2) ℂ),
      Eq.{1} (HMul.hMul.{0, 0, 0} (Matrix.conjTranspose.{0, 0, 0} g) g) 1 →
        Eq.{1} (Matrix.det.{0, 0} g) 1 → Commute.{0} M (AKLT.Defs.tensorPowerMatrix J g)) →
    ∀ (j : Fin 3) (t : ℝ),
      Commute.{0} M
        (AKLT.Defs.tensorPowerMatrix J
          (HAdd.hAdd.{0, 0, 0} 1
            (HSMul.hSMul.{0, 0, 0} (↑t)
              (HSMul.hSMul.{0, 0, 0} (Neg.neg.{0} Complex.I) (AKLT.Defs.pauli ⟨HAdd.hAdd.{0, 0, 0} (↑j) 1, ⋯⟩)))))
