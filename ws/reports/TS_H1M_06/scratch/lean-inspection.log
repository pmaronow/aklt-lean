Matrix.trace_mul_comm.{u_2, u_3, u_6} {m : Type u_2} {n : Type u_3} {R : Type u_6} [Fintype.{u_2} m] [Fintype.{u_3} n]
  [AddCommMonoid.{u_6} R] [CommMagma.{u_6} R] (A : Matrix.{u_2, u_3, u_6} m n R) (B : Matrix.{u_3, u_2, u_6} n m R) :
  Eq.{u_6 + 1} (Matrix.trace.{u_2, u_6} (HMul.hMul.{max (max u_2 u_3) u_6, max (max u_2 u_3) u_6, max u_2 u_6} A B))
