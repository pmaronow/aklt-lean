  BddAbove.{u_1} s → Membership.mem.{u_1, u_1} s a → LE.le.{u_1} a (sSup.{u_1} s)
@csSup_le.{u_1} : ∀ {α : Type u_1} [inst : ConditionallyCompleteLattice.{u_1} α] {s : Set.{u_1} α} {a : α},
  Set.Nonempty.{u_1} s → (∀ (b : α), Membership.mem.{u_1, u_1} s b → LE.le.{u_1} b a) → LE.le.{u_1} (sSup.{u_1} s) a
