def AKLT.Blueprint.Rec.uncoveredCountV2 : {G : Finset.{0} AKLT.Defs.Plane} →
  {n : Nat} → AKLT.Defs.Network G → AKLT.Defs.Plane → AKLT.Defs.Compass → AKLT.Defs.DirectionWord n → Nat :=
fun {G} {n} D u incoming w =>
  @Finset.card.{0} (Fin n)
    {i |
      And
        (@Eq.{1} AKLT.Defs.Status
          (@AKLT.Defs.Network.status G (@AKLT.Blueprint.Rec.prefixNetwork G n D u w (@Fin.val n i))
            (@AKLT.Defs.wordVertex n u w (@Fin.val n i)))
          AKLT.Defs.Status.U)
        (Not
          (@AKLT.Defs.CoveredDepartureV2 G (@AKLT.Blueprint.Rec.prefixNetwork G n D u w (@Fin.val n i))
            (@AKLT.Defs.wordVertex n u w (@Fin.val n i)) (@AKLT.Defs.wordIncoming n incoming w i) (w i)))}
