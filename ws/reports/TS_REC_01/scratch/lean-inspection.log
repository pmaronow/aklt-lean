structure AKLT.Blueprint.Rec.Departure : Type
number of parameters: 0
fields:
  AKLT.Blueprint.Rec.Departure.G : Finset AKLT.Defs.Plane
  AKLT.Blueprint.Rec.Departure.τ : AKLT.Defs.PinAssignment self.G
  AKLT.Blueprint.Rec.Departure.D : AKLT.Defs.Network self.G
  AKLT.Blueprint.Rec.Departure.y : AKLT.Defs.Plane
  AKLT.Blueprint.Rec.Departure.o : AKLT.Defs.Plane
  AKLT.Blueprint.Rec.Departure.auxiliary : self.D.Auxiliary
  AKLT.Blueprint.Rec.Departure.start : self.D.AdmissibleStart self.y
  AKLT.Blueprint.Rec.Departure.present : self.o ∈ self.D.presentNeighbours self.y
constructor:
  AKLT.Blueprint.Rec.Departure.mk (G : Finset AKLT.Defs.Plane) (τ : AKLT.Defs.PinAssignment G) (D : AKLT.Defs.Network G)
    (y o : AKLT.Defs.Plane) (auxiliary : D.Auxiliary) (start : D.AdmissibleStart y)
    (present : o ∈ D.presentNeighbours y) : AKLT.Blueprint.Rec.Departure
def AKLT.Blueprint.Rec.NetworkPositiveStatement : Prop :=
∀ (G : Finset AKLT.Defs.Plane) (τ : AKLT.Defs.PinAssignment G) (D : AKLT.Defs.Network G),
  D.Auxiliary → ∀ (b : Bool), 0 < D.partition τ b fun x => 1
def AKLT.Blueprint.Rec.ThreeFactorizationStatement : Prop :=
∀ (a : AKLT.Blueprint.Rec.Departure),
  a.D.status a.y = AKLT.Defs.Status.U →
    ∀ (f g : AKLT.Defs.Plane),
      a.D.presentNeighbours a.y = {a.o, f, g} →
        a.o ≠ f →
          a.o ≠ g →
            f ≠ g →
              ∀ (b : Bool),
                (a.D.partition a.τ b fun x => 1) =
                    ((AKLT.Defs.removeSite a.D a.y).partition a.τ b fun x => 1) *
                      AKLT.Defs.responseI a.D a.τ b a.y a.o f g ∧
                  ((AKLT.Defs.traceStep a.D a.y a.o).partition a.τ b fun x => 1) =
                    ((AKLT.Defs.removeSite a.D a.y).partition a.τ b fun x => 1) * AKLT.Defs.responseJ a.D a.τ b a.y f g
def AKLT.Blueprint.Rec.TwoFactorizationStatement : Prop :=
∀ (a : AKLT.Blueprint.Rec.Departure),
  a.D.status a.y = AKLT.Defs.Status.U →
    ∀ (f : AKLT.Defs.Plane),
      a.D.presentNeighbours a.y = {a.o, f} →
        a.o ≠ f →
          ∀ (b : Bool),
            (a.D.partition a.τ b fun x => 1) =
                ((AKLT.Defs.removeSite a.D a.y).partition a.τ b fun x => 1) *
                  AKLT.Blueprint.Rec.responseI₂ a.D a.τ b a.y a.o f ∧
              ((AKLT.Defs.traceStep a.D a.y a.o).partition a.τ b fun x => 1) =
                (AKLT.Defs.removeSite a.D a.y).partition a.τ b fun x => 1
def AKLT.Blueprint.Rec.RemovedMeanIntervalsStatement : Prop :=
∀ (a : AKLT.Blueprint.Rec.Departure),
  a.D.status a.y = AKLT.Defs.Status.U →
    ∀ (f g : AKLT.Defs.Plane),
      a.D.presentNeighbours a.y = {a.o, f, g} →
        a.o ≠ f →
          a.o ≠ g →
            f ≠ g →
              (∀ (b : Bool),
                  41 / 50 ≤ AKLT.Defs.responseI a.D a.τ b a.y a.o f g ∧
                    AKLT.Defs.responseI a.D a.τ b a.y a.o f g ≤ 34 / 25 ∧
                      116 / 125 ≤ AKLT.Defs.responseJ a.D a.τ b a.y f g ∧
                        AKLT.Defs.responseJ a.D a.τ b a.y f g ≤ 134 / 125) ∧
                1 ≤ AKLT.Defs.responseJ a.D a.τ false a.y f g ∧
                  AKLT.Defs.responseJ a.D a.τ false a.y f g ≤ AKLT.Defs.responseI a.D a.τ false a.y a.o f g
def AKLT.Blueprint.Rec.TwoMeanIntervalsStatement : Prop :=
∀ (a : AKLT.Blueprint.Rec.Departure),
  a.D.status a.y = AKLT.Defs.Status.U →
    ∀ (f : AKLT.Defs.Plane),
      a.D.presentNeighbours a.y = {a.o, f} →
        a.o ≠ f →
          (∀ (b : Bool),
              22 / 25 ≤ AKLT.Blueprint.Rec.responseI₂ a.D a.τ b a.y a.o f ∧
                AKLT.Blueprint.Rec.responseI₂ a.D a.τ b a.y a.o f ≤ 28 / 25) ∧
            1 ≤ AKLT.Blueprint.Rec.responseI₂ a.D a.τ false a.y a.o f
def AKLT.Blueprint.Rec.FreeRemovedPairStatement : Prop :=
∀ (a : AKLT.Blueprint.Rec.Departure),
  ∀ f ∈ a.D.presentNeighbours a.y,
    ∀ g ∈ a.D.presentNeighbours a.y, f ≠ g → 0 ≤ AKLT.Defs.removedPairMean a.D a.τ false a.y f g
def AKLT.Blueprint.Rec.LogMeanBasicStatement : Prop :=
∀ (x y : ℝ),
  0 < x →
    0 < y →
      0 < AKLT.Defs.logarithmicMean x y ∧
        min x y ≤ AKLT.Defs.logarithmicMean x y ∧
          AKLT.Defs.logarithmicMean x y ≤ max x y ∧ Real.log x - Real.log y = (x - y) / AKLT.Defs.logarithmicMean x y
def AKLT.Blueprint.Rec.LogMeanMonotoneStatement : Prop :=
∀ (x x' y y' : ℝ), 0 < x → x ≤ x' → 0 < y → y ≤ y' → AKLT.Defs.logarithmicMean x y ≤ AKLT.Defs.logarithmicMean x' y'
def AKLT.Defs.Network.partition : {G : Finset AKLT.Defs.Plane} →
  AKLT.Defs.Network G → AKLT.Defs.PinAssignment G → Bool → ((AKLT.Defs.Plane → AKLT.Defs.Vec3) → ℝ) → ℝ :=
fun {G} D τ pinned f =>
  ∑ n,
    ((∏ x, AKLT.Defs.spinWeight (D.status ↑x) (n x)) * f (D.spins n) *
        ∏ e ∈ D.bonds, (1 + AKLT.Defs.dot (D.spins n e.1) (D.spins n e.2))) *
      ∏ e, if pinned = true ∧ (↑e).1 ∈ D.active then 1 + AKLT.Defs.dot (↑(τ e)) (D.spins n (↑e).1) else 1
def AKLT.Defs.removedPairMean : {G : Finset AKLT.Defs.Plane} →
  AKLT.Defs.Network G → AKLT.Defs.PinAssignment G → Bool → AKLT.Defs.Plane → AKLT.Defs.Plane → AKLT.Defs.Plane → ℝ :=
fun {G} D τ pinned y a b => (AKLT.Defs.removeSite D y).expectation τ pinned fun n => AKLT.Defs.dot (n a) (n b)
def AKLT.Defs.logarithmicMean : ℝ → ℝ → ℝ :=
fun x y => if x = y then x else (x - y) / (Real.log x - Real.log y)
