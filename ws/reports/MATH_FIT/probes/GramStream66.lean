def rowOK (whole : IntRows) (c : Int) (i : Nat) (mr lr : List Int) : Bool :=
 let er := residualRow whole c mr lr
 decide (0 < er.getD i 0) && decide (absSum er < 2 * er.getD i 0)
def checkRows (whole : IntRows) (c : Int) : Nat → IntRows → IntRows → Bool
