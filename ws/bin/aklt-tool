#!/usr/bin/env python3
"""AKLT v4 entry point; v1 and v2 are retained untouched."""
from pathlib import Path
import sys
sys.dont_write_bytecode=True
sys.path.insert(0,str(Path(__file__).absolute().parents[1]/'tools/v4'))
from aklt_cli import main
from aklt_common import GateError
name=Path(sys.argv[0]).name
args=sys.argv[1:] if name=='aklt-tool' else [name.removeprefix('aklt-'),*sys.argv[1:]]
try: sys.exit(main(args))
except (GateError,OSError,ValueError,KeyError,TypeError) as e:
    print('aklt: '+str(e),file=sys.stderr); sys.exit(1)
